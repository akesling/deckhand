{
  "title": "deckhand json demo",
  "theme": {
    "border_type": "rounded",
    "accent": "magenta",
    "h1": "magenta",
    "bullet": "magenta",
    "max_width": 84,
    "pin_title": true,
    "title_gap": 2,
    "align_y": "top",
    "margin_x": 3,
    "margin_y": 2
  },
  "columns": [
    { "file": "slides/intro.md",
      "theme": { "pin_title": false, "align_y": "center" } },
    [
      "slides/layout.md",
      { "file": "slides/layout-deep.md", "notes": "Only come down here if someone asks how columns map to files." }
    ],
    [
      "slides/titles.md",
      "slides/titles-deep.md",
      { "file": "slides/titles-float.md",
        "theme": { "pin_title": false, "align_y": "center" },
        "notes": "Flip up and down here to watch the heading jump — that's pin_title." }
    ],
    [
      {
        "terminal": { "command": "htop" },
        "title": "htop",
        "theme": { "margin": 0, "max_width": 500, "accent": "red" },
        "notes": "This whole slide is one PTY, full-bleed via a per-slide theme. q quits htop, R respawns it."
      },
      { "terminal": {},

        "theme": { "margin": 0, "max_height": 20, "max_width": 100, "accent": "red" },
          "title": "scratch shell" },
      {
        "panes": [
          "slides/panes.md",
          { "terminal": { "command": "python3 -q", "rows": 8 } },
          { "terminal": {} }
        ],
        "title": "stacked panes",
        "notes": "Two terminals stacked: a fixed-height python REPL and a fill shell below it. t cycles focus."
      }
    ],
    { "file": "slides/qr.md", "notes": "Scannable straight off the screen — drawn black-on-white whatever the theme says." },
    { "file": "slides/fin.md",
      "theme": { "pin_title": false, "align_y": "center" },
      "notes_file": "slides/fin-notes.md" }
  ]
}
